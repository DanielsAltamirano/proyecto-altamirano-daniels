# Inicialización del contenedor MariaDB
MARIADB_ROOT_PASSWORD=coloca_aqui_root_password
MARIADB_DATABASE=reservaciones_db
MARIADB_USER=reservaciones_user
MARIADB_PASSWORD=coloca_aqui_user_password

# Variables para el Backend -> MariaDB
DB_HOST=db
DB_PORT=5432
DB_NAME=reservaciones_db
DB_USER=reservaciones_user
DB_PASS=coloca_aqui_user_password

# Variables para el Backend -> Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CACHE_TTL=45

# Variables para el Backend -> Mailpit
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=notificaciones@reservaciones.local